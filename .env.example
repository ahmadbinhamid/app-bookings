# Used by docker-compose.yml for the mysql/migrate/backend/frontend/phpmyadmin
# services. For running the backend directly on the host (no Docker), see
# backend/.env.example instead.

# --- Database ---
MYSQL_ROOT_PASSWORD=root
DB_DATABASE=FlowPos
DB_USERNAME=app_booking
DB_PASSWORD=secret

# --- Host port overrides ---
# Defaults are offset from sibling projects' compose stacks to avoid clashes:
#   ai-builder:   mysql 3306/3307, backend 8080, frontend 3000, phpmyadmin 8081
#   quotes:       mysql 3308,      backend 8082, frontend 3001, phpmyadmin 8083
#   appointments: mysql 3309,      backend 8084, frontend 3002, phpmyadmin 8085
MYSQL_HOST_PORT=3310
BACKEND_HOST_PORT=8086
FRONTEND_HOST_PORT=3003
PHPMYADMIN_HOST_PORT=8087

# --- Auth / marketplace lifecycle (passed through to the backend service) ---
JWT_SECRET=dev-insecure-secret-change-me
JWT_DEV_TOKENS=true
FLOWPOS_SIGNING_SECRET=dev-insecure-signing-secret-change-me

# --- Frontend build arg ---
# Origins allowed to complete the apps-sdk postMessage handshake when this
# app is embedded in tenant-dashboard (theme sync, etc).
VITE_FLOWPOS_DASHBOARD_ORIGINS=http://localhost:5173,http://localhost:3000
